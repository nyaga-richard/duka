# DEVELOPMENT ONLY. Create separate ordinary PostgreSQL roles/databases first.
NODE_ENV=development
DATABASE_URL=postgresql://duka:CHANGE_ME@127.0.0.1:5432/duka
TEST_DATABASE_URL=postgresql://duka:CHANGE_ME@127.0.0.1:5432/duka_test
PORT=4000
WEB_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
TRUST_PROXY=0
SESSION_HOURS=12
UPLOAD_DIR=uploads
# Generate BEFORE using MFA: openssl rand -base64 32
# MFA_ENCRYPTION_KEY=YOUR_STABLE_RANDOM_32_BYTE_BASE64_KEY
# The production API requires a non-owning, non-privileged DB role and this key.
MAIL_MODE=outbox
MAIL_FROM=no-reply@localhost
# SMTP_URL=smtps://url_encoded_user:url_encoded_password@mail.example.com:465
DEMO_MODE=false
# WORKSPACE_PREVIEW=true  # isolated demo API only: secure partitioned viewer login
# WORKSPACE_BUILD_DIR=.cache/next-workspace-r2  # versioned stable preview build
MPESA_MODE=disabled
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
# For merchant-onboarded live production use https://api.safaricom.co.ke instead.
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_BASE_URL=https://pos.yourdomain.example
# MPESA_CALLBACK_SECRET=GENERATE_AN_INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_CHARS
ETIMS_MODE=disabled
# ETIMS_ADAPTER_URL=https://your-certified-gateway.example/api/invoices
# ETIMS_ADAPTER_TOKEN=
# Operator CLIs only, never the API's environment:
# BACKUP_DATABASE_URL=postgresql://read_only_backup_role:...@db/duka
# BACKUP_PASSPHRASE_FILE=/etc/duka/backup.key
# RESTORE_ADMIN_DATABASE_URL=postgresql://disposable_restore_role:...@db/postgres
