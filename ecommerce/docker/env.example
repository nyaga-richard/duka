# Standalone stack only (docker/docker-compose.yml):
#   cp docker/env.example docker/.env && docker compose -f docker/docker-compose.yml --env-file docker/.env up -d --build
# The Duka-managed stack does NOT read this file; it uses
# deploy/ecommerce/.env.shop generated by deploy/ecommerce/init-shop-env.sh.
POSTGRES_USER=ecommerce_app
POSTGRES_DB=ecommerce
POSTGRES_PASSWORD=replace-with-a-long-random-value
API_PORT=4100
WEB_PORT=3100
WEB_ORIGIN=http://localhost:3100
ALLOWED_ORIGINS=http://localhost:3100
COOKIE_SECURE=false
PAYMENTS_MODE=manual
ERP_ENABLED=false
ERP_BASE_URL=
ERP_ALLOWED_ORIGIN=
ERP_INTEGRATION_EMAIL=
ERP_INTEGRATION_PASSWORD=
ERP_DEFAULT_BRANCH_ID=
ERP_DEFAULT_WAREHOUSE_ID=
LOG_LEVEL=info
