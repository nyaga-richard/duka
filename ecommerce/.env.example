# ---------------------------------------------------------------------------
# Duka E-commerce — Phase 1. Copy to .env and set real values.
# Never commit .env. Never reuse ERP database credentials here.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4100
API_PUBLIC_URL=http://localhost:4100
WEB_ORIGIN=http://localhost:3100
# Comma separated browser origins allowed to call the API with credentials.
ALLOWED_ORIGINS=http://localhost:3100
COOKIE_SECURE=false

# Database. Development may use the embedded PGlite driver; production MUST use PostgreSQL.
# DATABASE_URL=postgresql://ecommerce_app:CHANGE_ME@ecommerce-db:5432/ecommerce
DATABASE_URL=pglite://./.pglite/dev
DATABASE_POOL_MAX=10
MIGRATION_LOCK_ID=918273645

# Session / security
CUSTOMER_SESSION_HOURS=24
GUEST_SESSION_HOURS=24
ADMIN_SESSION_HOURS=8
CART_RESERVATION_MINUTES=15
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ERP integration (read-only contract verified from nyaga-richard/duka).
# Use a dedicated ERP integration identity with the minimum role, never an owner login.
ERP_ENABLED=false
ERP_BASE_URL=https://pos.example.internal
# Origin sent on ERP mutations. Must be in the ERP ALLOWED_ORIGINS list.
# Recommended: add your e-commerce API origin to the ERP allowlist and use it here.
ERP_ALLOWED_ORIGIN=https://shop-api.example.internal
ERP_INTEGRATION_EMAIL=
ERP_INTEGRATION_PASSWORD=
ERP_INTEGRATION_TOTP_SECRET=
ERP_DEFAULT_BRANCH_ID=
ERP_DEFAULT_WAREHOUSE_ID=
ERP_REQUEST_TIMEOUT_MS=15000
ERP_MAX_ATTEMPTS=3
ERP_RESERVE_ORDERS_IN_ERP=false
# ERP_SYNC_INTERVAL_MS=300000

# Payments. Phase 1 boundary only: manual is the default, live capture stays off.
PAYMENTS_MODE=manual
PAYMENT_CAPTURE_ENABLED=false
MPESA_MODE=disabled
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_SECRET=
MPESA_CALLBACK_BASE_URL=

LOG_LEVEL=info
TRUST_PROXY=0
