{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".cache/next-e2e/types/**/*.ts",
    ".cache/next-e2e/dev/types/**/*.ts",
    ".cache/next-preview/types/**/*.ts",
    ".cache/next-preview/dev/types/**/*.ts",
    ".cache/next-e2e-production/types/**/*.ts",
    ".cache/next-e2e-production/dev/types/**/*.ts",
    ".cache/next-workspace/types/**/*.ts",
    ".cache/next-workspace/dev/types/**/*.ts",
    ".cache/next-workspace-r2/types/**/*.ts",
    ".cache/next-workspace-r2/dev/types/**/*.ts",
    ".cache/next-workspace-r3/types/**/*.ts",
    ".cache/next-workspace-r3/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
