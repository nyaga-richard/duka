{
  "name": "duka-business-os",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.9 <25"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:web": "NEXT_BUILD_DIR=.cache/next-preview next dev apps/web --hostname 0.0.0.0 --port 3000",
    "build": "npm run typecheck && next build apps/web --webpack && tsx scripts/build.ts && tsx scripts/prepare-web.ts",
    "start:api": "node artifacts/server/api.mjs",
    "start:web": "HOSTNAME=0.0.0.0 node artifacts/web/apps/web/server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "node --import tsx --import ./scripts/test-env.ts --test --test-reporter=tap --test-concurrency=1 tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:unit": "tsx --test --test-reporter=tap tests/unit/*.test.ts",
    "test:integration": "node --import tsx --import ./scripts/test-env.ts --test --test-reporter=tap --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:setup": "tsx scripts/setup.ts",
    "db:demo": "tsx database/seeds/demo.ts",
    "db:reconcile": "tsx scripts/reconcile.ts",
    "security:audit": "npm audit --omit=dev",
    "release": "bash scripts/package.sh",
    "build:server": "tsx scripts/build.ts",
    "backup": "tsx scripts/backup.ts",
    "backup:unpack": "tsx scripts/unpack-backup.ts",
    "backup:restore-test": "tsx scripts/restore-test.ts",
    "format": "prettier --write apps packages scripts tests database/seeds docs README.md playwright.config.ts",
    "format:check": "prettier --check apps packages scripts tests database/seeds docs README.md playwright.config.ts",
    "test:production": "tsx tests/production-smoke.ts",
    "verify": "bash scripts/verify.sh",
    "workspace:build": "node scripts/workspace-web.mjs --build",
    "workspace:web": "node scripts/workspace-web.mjs",
    "test:workspace-login": "tsx tests/workspace-login-smoke.ts"
  },
  "dependencies": {
    "@duka/accounting": "*",
    "@duka/inventory": "*",
    "@duka/shared": "*",
    "argon2": "0.45.1",
    "cookie": "1.0.2",
    "decimal.js": "10.6.0",
    "dotenv": "17.2.3",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "nodemailer": "10.1.2",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/cookie": "0.6.0",
    "@types/express": "5.0.6",
    "@types/node": "22.19.7",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.25.12",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "type": "module",
  "packageManager": "npm@10.8.2"
}
